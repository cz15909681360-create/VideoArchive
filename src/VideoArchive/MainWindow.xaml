<Window x:Class="VideoArchive.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VideoArchive · 视频压缩备份" Width="1380" Height="940" MinWidth="1100" MinHeight="720" WindowStartupLocation="CenterScreen" AllowDrop="True" Drop="Window_Drop" Closing="Window_Closing" ContentRendered="Window_ContentRendered">
  <Grid>
    <Border><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#E9F4F4"/><GradientStop Color="#EFF0FA" Offset="0.55"/><GradientStop Color="#FFF4E8" Offset="1"/></LinearGradientBrush></Border.Background></Border>
    <Viewbox Stretch="Fill" IsHitTestVisible="False" Opacity="0.52"><Canvas Width="1380" Height="940" ClipToBounds="True"><Ellipse Width="740" Height="740" Canvas.Left="860" Canvas.Top="-370" Stroke="#C7DDE7" StrokeThickness="64"/><Ellipse Width="380" Height="380" Canvas.Left="1040" Canvas.Top="-180" Stroke="#D4D8EF" StrokeThickness="1"/><Path Data="M100,940 C420,620 550,900 850,650 S1200,800 1440,530 L1440,940 Z" Fill="#DBEDEA"/><Path Data="M260,940 C520,800 600,950 920,800 S1180,920 1400,760" Stroke="#BBDDD9" StrokeThickness="2"/><Ellipse Width="100" Height="100" Canvas.Left="1120" Canvas.Top="680" Fill="#F5DCC4"/></Canvas></Viewbox>
    <Image Source="{Binding WallpaperImage}" Opacity="{Binding WallpaperOpacity}" Stretch="UniformToFill" IsHitTestVisible="False"/>
    <Grid Background="Transparent">
    <Grid.ColumnDefinitions><ColumnDefinition Width="188"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border BorderBrush="#173B50" BorderThickness="0,0,1,0"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#143349"/><GradientStop Color="#20585C" Offset="1"/></LinearGradientBrush></Border.Background>
      <DockPanel Margin="18,28,18,20">
        <StackPanel DockPanel.Dock="Top" Margin="2,0,0,30"><Border Background="#4BC5B6" Width="44" Height="44" CornerRadius="13" HorizontalAlignment="Left" Margin="0,0,0,15"><Path Data="{StaticResource PlayIcon}" Style="{StaticResource Icon}" Stroke="White" Fill="White" Width="19" Height="19"/></Border><TextBlock Text="VideoArchive" FontSize="19" FontWeight="Bold" Foreground="White" TextWrapping="NoWrap"/><TextBlock Text="视频压缩 · 素材归档" Foreground="#B8DAD9" FontSize="11" Margin="0,7,0,0"/></StackPanel>
        <StackPanel DockPanel.Dock="Bottom"><Border Background="#264F5C" CornerRadius="10" Padding="12"><StackPanel><TextBlock Text="◇  只降不升" FontWeight="Bold" Foreground="#86E1CE"/><TextBlock Text="让容量更轻，让分类完整" Foreground="#C0D8DF" FontSize="11" Margin="0,7,0,0"/></StackPanel></Border><TextBlock Text="本地处理 · 源文件不改写" FontSize="10" Foreground="#A2C5CE" Margin="0,15,0,0"/></StackPanel>
        <StackPanel>
          <Button Content="▶   压缩任务" Command="{Binding NavigateCommand}" CommandParameter="压缩任务"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource Nav}"><Style.Triggers><DataTrigger Binding="{Binding TaskPage}" Value="True"><Setter Property="Background" Value="#3C797B"/><Setter Property="Foreground" Value="White"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
          <Button Content="◆   压缩方案" Command="{Binding NavigateCommand}" CommandParameter="压缩方案"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource Nav}"><Style.Triggers><DataTrigger Binding="{Binding PresetPage}" Value="True"><Setter Property="Background" Value="#3C797B"/><Setter Property="Foreground" Value="White"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
          <Button Content="◷   任务历史" Command="{Binding NavigateCommand}" CommandParameter="任务历史"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource Nav}"><Style.Triggers><DataTrigger Binding="{Binding HistoryPage}" Value="True"><Setter Property="Background" Value="#3C797B"/><Setter Property="Foreground" Value="White"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
          <Button Content="◈   设置与外观" Command="{Binding NavigateCommand}" CommandParameter="设置"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource Nav}"><Style.Triggers><DataTrigger Binding="{Binding SettingsPage}" Value="True"><Setter Property="Background" Value="#3C797B"/><Setter Property="Foreground" Value="White"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
        </StackPanel>
      </DockPanel>
    </Border>
    <Grid Grid.Column="1" Margin="28,24,28,18">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <DockPanel Margin="0,0,0,20"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="◈  自定义壁纸" Command="{Binding NavigateCommand}" CommandParameter="设置" Background="#EEF4F5"/><Button Content="＋  新建任务" Command="{Binding NewTaskCommand}" Margin="0"/></StackPanel><StackPanel><TextBlock Text="{Binding Page}" FontSize="28" FontWeight="Bold"/><TextBlock Text="保存每一份素材，也留住你的工作习惯。" Foreground="{StaticResource Muted}" Margin="0,7,0,0"/></StackPanel></DockPanel>
      <ScrollViewer x:Name="TaskScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="{Binding TaskPage, Converter={StaticResource BoolVisibility}}">
        <StackPanel Margin="0,0,9,0">
          <Border Style="{StaticResource Card}"><Grid IsEnabled="{Binding FolderSelectionEnabled}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <StackPanel><StackPanel Orientation="Horizontal" Margin="0,0,0,12"><Border Background="#FFF0DC" CornerRadius="8" Padding="7" Margin="0,0,10,0"><Path Style="{StaticResource Icon}" Data="{StaticResource FolderIcon}" Stroke="{StaticResource Amber}"/></Border><StackPanel><TextBlock Text="源素材文件夹" FontSize="15" FontWeight="Bold"/><TextBlock Text="01  选择或拖入整个素材目录" FontSize="10" Foreground="{StaticResource Amber}" Margin="0,3,0,0"/></StackPanel></StackPanel><DockPanel><Button Content="选择" Command="{Binding ChooseSourceCommand}" DockPanel.Dock="Right" Margin="8,0,0,0" Background="#FFF3E2" Foreground="{StaticResource Amber}"/><TextBox Text="{Binding SourceRoot, UpdateSourceTrigger=PropertyChanged}" ToolTip="可以拖入整个源文件夹" Background="#FFFBF5" BorderBrush="#EAD9BD"/></DockPanel></StackPanel>
            <StackPanel Grid.Column="2"><StackPanel Orientation="Horizontal" Margin="0,0,0,12"><Border Background="#E2F2EC" CornerRadius="8" Padding="7" Margin="0,0,10,0"><Path Style="{StaticResource Icon}" Data="{StaticResource ArchiveIcon}" Stroke="{StaticResource Emerald}"/></Border><StackPanel><TextBlock Text="输出备份文件夹" FontSize="15" FontWeight="Bold"/><TextBlock Text="02  默认与源文件夹并列" FontSize="10" Foreground="{StaticResource Emerald}" Margin="0,3,0,0"/></StackPanel></StackPanel><TextBox Text="{Binding OutputRoot, Mode=OneWay}" IsReadOnly="True" Background="#F2FAF7" Foreground="{StaticResource Emerald}" BorderBrush="#C8E3D8" ToolTip="默认在源文件夹旁创建“源文件夹名_已压缩”，例如 D:\素材 → D:\素材_已压缩"/><TextBlock Text="{Binding OutputFolderName}" Foreground="{StaticResource Accent}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,7,0,0"/><CheckBox Content="输出到其他文件夹" IsChecked="{Binding OtherOutput}" Margin="0,9,0,6"/><DockPanel Visibility="{Binding OtherOutput, Converter={StaticResource BoolVisibility}}"><Button Content="选择位置" Command="{Binding ChooseOutputCommand}" DockPanel.Dock="Right" Margin="8,0,0,0"/><TextBox Text="{Binding OutputParent, UpdateSourceTrigger=PropertyChanged}" ToolTip="在此位置下自动创建“源文件夹名_已压缩”"/></DockPanel><TextBlock Text="默认与源文件夹并列 · 完整保留分类目录和配套文件" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,9,0,0" TextWrapping="Wrap"/></StackPanel>
          </Grid></Border>
          <Border Style="{StaticResource Card}"><StackPanel>
            <DockPanel Margin="0,0,0,16"><Button Content="＋  高级参数" DockPanel.Dock="Right" Command="{Binding AdvancedCommand}" Foreground="{StaticResource Violet}" Background="#F4EFFB"/><StackPanel Orientation="Horizontal" IsEnabled="{Binding Idle}"><Border Background="#EEE5FA" CornerRadius="8" Padding="7" Margin="0,0,10,0"><Path Style="{StaticResource Icon}" Data="{StaticResource ChipIcon}" Stroke="{StaticResource Violet}"/></Border><TextBlock Text="03  压缩方案" FontSize="16" FontWeight="Bold" Margin="0,0,18,0"/><ComboBox Width="210" ItemsSource="{Binding Presets}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedPreset}" FontWeight="SemiBold"/></StackPanel></DockPanel>
            <Grid IsEnabled="{Binding Idle}"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
              <StackPanel Margin="0,0,15,0"><TextBlock Text="◆  编码设备" Style="{StaticResource Label}" Foreground="{StaticResource Violet}"/><ComboBox ItemsSource="{Binding BackendOptions}" SelectedItem="{Binding Settings.Backend}"/></StackPanel>
              <StackPanel Grid.Column="1" Margin="0,0,15,0"><TextBlock Text="▣  视频编码" Style="{StaticResource Label}" Foreground="{StaticResource Accent}"/><ComboBox ItemsSource="{Binding CodecOptions}" SelectedItem="{Binding Settings.Codec}"/></StackPanel>
              <StackPanel Grid.Column="2" Margin="0,0,15,0"><TextBlock Text="码率控制" Style="{StaticResource Label}"/><ComboBox ItemsSource="{Binding RateOptions}" SelectedItem="{Binding Settings.RateMode}"/></StackPanel>
              <StackPanel Grid.Column="3"><TextBlock Text="◇  备份质量系数" Style="{StaticResource Label}" Foreground="{StaticResource Violet}"/><ComboBox ItemsSource="{Binding QualityOptions}" SelectedItem="{Binding Settings.Quality}" ToolTip="0.75 空间优先 · 1.00 平衡 · 1.25 高质量 · 1.50 极高质量"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding StringFormat=×{0:0.00}}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox></StackPanel>
            </Grid>
            <Grid IsEnabled="{Binding Idle}" Margin="0,15,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
              <StackPanel Margin="0,0,15,0"><TextBlock Text="码率策略" Style="{StaticResource Label}"/><ComboBox ItemsSource="{Binding BitrateOptions}" SelectedItem="{Binding Settings.BitrateMode}"/></StackPanel>
              <StackPanel Grid.Column="1" Margin="0,0,15,0"><TextBlock Text="平均码率上限（Mbps）" Style="{StaticResource Label}"/><TextBox IsEnabled="{Binding FixedBitrateEnabled}" Text="{Binding Settings.FixedMbps, UpdateSourceTrigger=PropertyChanged}" FontWeight="Bold" ToolTip="仅固定上限模式使用此值；智能模式按每个文件最终规格计算"/></StackPanel>
              <StackPanel Grid.Column="2" Margin="0,0,15,0"><TextBlock Text="最高帧率（fps）" Style="{StaticResource Label}"/><TextBox Text="{Binding Settings.FpsLimit, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Settings.LimitFps}" FontWeight="Bold"/></StackPanel>
              <StackPanel Grid.Column="3"><TextBlock Text="♪  音频保留方式" Style="{StaticResource Label}" Foreground="{StaticResource Emerald}"/><ComboBox ItemsSource="{Binding AudioOptions}" SelectedItem="{Binding Settings.Audio}"/></StackPanel>
            </Grid>
            <WrapPanel IsEnabled="{Binding Idle}" Margin="0,10,0,0"><CheckBox Content="允许降低至最高1080P" IsChecked="{Binding Settings.Limit1080}"/><CheckBox Content="启用最高帧率限制" IsChecked="{Binding Settings.LimitFps}"/><CheckBox Content="统一编码格式" IsChecked="{Binding Settings.Unified}" ToolTip="开启后，即使码率足够低，也转换不符合目标编码的视频"/></WrapPanel>
            <Border Background="#EDF3FB" BorderBrush="#D1E0F3" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,9,0,0"><TextBlock Text="{Binding ParameterSummary}" Foreground="#234EA4" FontWeight="SemiBold"/></Border>
            <TextBlock Text="{Binding RateNote}" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,8,0,0"/>
            <TextBlock Text="10-bit 4:2:2 / 4:4:4 及更高规格 YUV 素材自动转换为10-bit 4:2:0、HEVC Main10；扫描表注明实际目标。" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,7,0,0"/>
          </StackPanel></Border>
          <Border Style="{StaticResource Card}"><StackPanel>
            <DockPanel Margin="0,0,0,14"><StackPanel Orientation="Horizontal" DockPanel.Dock="Right"><Button Content="◎  扫描素材" Style="{StaticResource Primary}" Command="{Binding ScanCommand}"/><Button Style="{StaticResource BackupButton}" Command="{Binding RunCommand}" Margin="0"><StackPanel Orientation="Horizontal"><Path Style="{StaticResource Icon}" Data="{StaticResource PlayIcon}" Width="14" Height="14" Fill="White" Stroke="White" Margin="0,0,9,0"/><TextBlock Text="开始 / 恢复备份"/></StackPanel></Button></StackPanel><TextBlock Text="04  扫描计划与检查" FontSize="17" FontWeight="Bold"/></DockPanel>
            <TextBlock Text="{Binding ScanSummary}"/><TextBlock Text="{Binding EstimateSummary}" Foreground="{StaticResource Accent}" FontWeight="SemiBold" Margin="0,8,0,0"/><TextBlock Text="{Binding Distribution}" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,8,0,0"/>
            <DockPanel Margin="0,14,0,10"><Button Content="查看文件详情 / 命令" Command="{Binding ShowLogCommand}" DockPanel.Dock="Right"/><ComboBox Width="125" HorizontalAlignment="Left" ItemsSource="{Binding FilterOptions}" SelectedItem="{Binding Filter}"/></DockPanel>
            <Border x:Name="ReviewPanel" Background="#FFF3DB" BorderBrush="#F0D299" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,12" Visibility="{Binding HasReviewItems, Converter={StaticResource BoolVisibility}}">
              <DockPanel><Button Content="!  打开文件决策窗口" DockPanel.Dock="Right" Command="{Binding OpenReviewCommand}" Style="{StaticResource AttentionButton}" Margin="14,0,0,0"/><StackPanel><TextBlock Text="{Binding ReviewAlert}" Foreground="#875611" FontWeight="Bold" FontSize="14"/><TextBlock Text="在弹窗中勾选文件，统一或分别选择处理方式。" Foreground="#98723B" FontSize="11" Margin="0,5,0,0"/></StackPanel></DockPanel>
            </Border>
            <DataGrid x:Name="ScanGrid" ItemsSource="{Binding ItemView}" SelectedItem="{Binding SelectedItem}" Height="260" EnableRowVirtualization="True" EnableColumnVirtualization="True">
              <DataGrid.Columns>
                <DataGridTextColumn Header="文件 / 相对路径" Binding="{Binding RelativePath}" Width="1.6*" MinWidth="130"/>
                <DataGridTextColumn Header="源规格" Binding="{Binding SourceSpec}" ElementStyle="{StaticResource GridSpec}" Width="1.5*" MinWidth="145"/>
                <DataGridTextColumn Header="目标规格" Binding="{Binding TargetSpec}" ElementStyle="{StaticResource GridSpec}" Width="1.3*" MinWidth="130"/>
                <DataGridTemplateColumn Header="处理" Width="85"><DataGridTemplateColumn.CellTemplate><DataTemplate><Border CornerRadius="7" Padding="7,5" HorizontalAlignment="Left"><Border.Style><Style TargetType="Border"><Setter Property="Background" Value="#E7F2ED"/><Style.Triggers><DataTrigger Binding="{Binding Action}" Value="压缩"><Setter Property="Background" Value="#ECE5F7"/></DataTrigger><DataTrigger Binding="{Binding Action}" Value="待决定"><Setter Property="Background" Value="#FFF0D3"/></DataTrigger><DataTrigger Binding="{Binding Action}" Value="跳过"><Setter Property="Background" Value="#E8EDF3"/></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock Text="{Binding Action}" FontWeight="SemiBold" FontSize="11"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#0B7864"/><Style.Triggers><DataTrigger Binding="{Binding Action}" Value="压缩"><Setter Property="Foreground" Value="#7146AD"/></DataTrigger><DataTrigger Binding="{Binding Action}" Value="待决定"><Setter Property="Foreground" Value="#9B691C"/></DataTrigger><DataTrigger Binding="{Binding Action}" Value="跳过"><Setter Property="Foreground" Value="#596B7E"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Border></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                <DataGridTextColumn Header="原因" Binding="{Binding Reason}" Width="1.6*" MinWidth="155"/>
                <DataGridTextColumn Header="预计容量" Binding="{Binding EstimateText}" Width="80"/>
                <DataGridTextColumn Header="状态" Binding="{Binding DisplayStatus}" ElementStyle="{StaticResource GridStatus}" Width="1.3*" MinWidth="100"/>
              </DataGrid.Columns>
            </DataGrid>
            <TextBlock Text="{Binding Notices}" Foreground="#BA7315" FontSize="11" Margin="0,8,0,0"/>
          </StackPanel></Border>
          <Border x:Name="ProgressCard" Style="{StaticResource Card}"><StackPanel>
            <DockPanel><StackPanel Orientation="Horizontal" DockPanel.Dock="Right"><Button Content="{Binding PauseLabel}" Command="{Binding PauseCommand}"/><Button Content="取消" Command="{Binding CancelCommand}" Foreground="{StaticResource Rose}" Background="#FFF0F3"/><Button Content="↻  重试失败" Command="{Binding RetryCommand}"/></StackPanel><TextBlock Text="✓  备份进度与报告" FontSize="17" FontWeight="Bold" Foreground="{StaticResource Emerald}"/></DockPanel>
            <TextBlock Text="{Binding ProgressText}" Margin="0,14,0,8"/><ProgressBar Value="{Binding OverallProgress, Mode=OneWay}" Maximum="100"/><TextBlock Text="{Binding CurrentFile}" Margin="0,9,0,0" FontSize="12"/><TextBlock Text="{Binding Eta}" Foreground="{StaticResource Muted}" Margin="0,8,0,14"/>
            <Border Background="#F2F8F4" CornerRadius="7" Padding="14"><TextBlock Text="{Binding Report}" Foreground="#276343"/></Border>
            <WrapPanel Margin="0,14,0,0"><Button Content="打开输出文件夹" Command="{Binding OpenOutputCommand}"/><Button Content="导出 CSV" Command="{Binding ExportCsvCommand}"/><Button Content="导出 JSON" Command="{Binding ExportJsonCommand}"/><Button Content="查看失败文件" Command="{Binding NavigateCommand}" CommandParameter="压缩任务" Click="ShowFailures_Click"/></WrapPanel>
          </StackPanel></Border>
        </StackPanel>
      </ScrollViewer>
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="{Binding PresetPage, Converter={StaticResource BoolVisibility}}"><StackPanel Margin="0,0,8,0">
        <Border Style="{StaticResource Card}"><StackPanel IsEnabled="{Binding Idle}">
          <TextBlock Text="把常用备份策略保存下来" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="选择方案后，在压缩任务页面调整参数，再保存为当前方案或创建副本。" Foreground="{StaticResource Muted}" Margin="0,10,0,20"/>
          <ListBox ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}" BorderThickness="0" Background="Transparent" MinHeight="240"><ListBox.ItemTemplate><DataTemplate><Border Background="#F5F8FD" CornerRadius="8" Padding="16" Margin="0,4" Width="750"><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="16"/><TextBlock Text="{Binding Settings.Summary}" Foreground="{StaticResource Muted}" Margin="0,7,0,0"/></StackPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox>
          <TextBlock Text="方案名称" Style="{StaticResource Label}" Margin="0,16,0,7"/><TextBox Text="{Binding PresetName, UpdateSourceTrigger=PropertyChanged}" MaxWidth="480" HorizontalAlignment="Left" Width="480"/>
          <WrapPanel Margin="0,16,0,12"><Button Content="保存当前方案" Style="{StaticResource Primary}" Command="{Binding SavePresetCommand}"/><Button Content="创建副本" Command="{Binding DuplicatePresetCommand}"/><Button Content="重命名" Command="{Binding RenamePresetCommand}"/><Button Content="设为默认" Command="{Binding DefaultPresetCommand}"/><Button Content="删除" Command="{Binding DeletePresetCommand}"/></WrapPanel>
          <TextBlock Text="{Binding DefaultPresetText}" Foreground="{StaticResource Accent}"/>
        </StackPanel></Border>
      </StackPanel></ScrollViewer>
      <Grid Grid.Row="1" Visibility="{Binding HistoryPage, Converter={StaticResource BoolVisibility}}"><Border Style="{StaticResource Card}"><DockPanel>
        <StackPanel DockPanel.Dock="Top"><TextBlock Text="本地任务记录" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="中断后可载入任务，完成文件经过校验后跳过，未完成文件从头处理。" Foreground="{StaticResource Muted}" Margin="0,9,0,20"/></StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Margin="0,15,0,0"><Button Content="载入记录 / 恢复任务" Command="{Binding LoadHistoryCommand}" HorizontalAlignment="Left" Style="{StaticResource Primary}"/></StackPanel>
        <ListBox ItemsSource="{Binding History}" SelectedItem="{Binding SelectedHistory}" BorderThickness="0"><ListBox.ItemTemplate><DataTemplate><Border Background="#F5F8FD" CornerRadius="8" Padding="16" Margin="0,5" Width="760"><StackPanel><TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="{Binding SourceRoot}" Margin="0,8,0,0"/><TextBlock Text="{Binding OutputRoot}" Foreground="{StaticResource Muted}" Margin="0,5,0,0"/></StackPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox>
      </DockPanel></Border></Grid>
      <ScrollViewer Grid.Row="1" Visibility="{Binding SettingsPage, Converter={StaticResource BoolVisibility}}" VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,8,0">
        <Border Style="{StaticResource Card}"><StackPanel IsEnabled="{Binding Idle}"><StackPanel Orientation="Horizontal"><Border Background="#EEE5FA" CornerRadius="9" Padding="9" Margin="0,0,12,0"><TextBlock Text="◈" FontSize="22" Foreground="{StaticResource Violet}"/></Border><StackPanel><TextBlock Text="外观与自定义壁纸" FontSize="20" FontWeight="Bold"/><TextBlock Text="{Binding WallpaperDescription}" Foreground="{StaticResource Muted}" Margin="0,6,0,0"/></StackPanel></StackPanel>
          <Grid Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="24"/><ColumnDefinition/></Grid.ColumnDefinitions><Border Background="#DAE9ED" CornerRadius="12" Height="128" ClipToBounds="True"><Image Source="{Binding WallpaperImage}" Stretch="UniformToFill"/></Border><StackPanel Grid.Column="2"><WrapPanel><Button Content="＋  选择本地壁纸" Style="{StaticResource EncodeButton}" Command="{Binding ChooseWallpaperCommand}"/><Button Content="恢复默认背景" Command="{Binding ResetWallpaperCommand}"/></WrapPanel><TextBlock Text="壁纸显示强度" Style="{StaticResource Label}" Margin="0,18,0,7"/><DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding WallpaperOpacity, StringFormat={}{0:P0}}" FontWeight="Bold" Foreground="{StaticResource Violet}" Margin="15,0,0,0"/><Slider Value="{Binding WallpaperOpacity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="0.05" Maximum="1" TickFrequency="0.05" SmallChange="0.05"/></DockPanel><TextBlock Text="支持 PNG、JPG、BMP、GIF 静态显示。浅色卡片保持清晰，图片自动保存在本机。" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,10,0,0"/></StackPanel></Grid>
        </StackPanel></Border>
        <Border Style="{StaticResource Card}"><StackPanel IsEnabled="{Binding Idle}"><TextBlock Text="编码引擎" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="便携包优先使用附带引擎，也可指定本机版本。更换后会重新检测能力。" Foreground="{StaticResource Muted}" Margin="0,10,0,18"/>
          <TextBlock Text="FFmpeg 路径" Style="{StaticResource Label}"/><DockPanel><Button Content="选择" Command="{Binding BrowseFfmpegCommand}" DockPanel.Dock="Right" Margin="8,0,0,0"/><TextBox Text="{Binding FfmpegPath, UpdateSourceTrigger=PropertyChanged}"/></DockPanel>
          <TextBlock Text="FFprobe 路径" Style="{StaticResource Label}" Margin="0,15,0,7"/><DockPanel><Button Content="选择" Command="{Binding BrowseFfprobeCommand}" DockPanel.Dock="Right" Margin="8,0,0,0"/><TextBox Text="{Binding FfprobePath, UpdateSourceTrigger=PropertyChanged}"/></DockPanel>
          <Button Content="保存路径并重新检测" Command="{Binding ApplyToolsCommand}" Style="{StaticResource Primary}" Margin="0,18,0,0" HorizontalAlignment="Left"/>
        </StackPanel></Border>
        <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="编码能力 · 实际短帧验证" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="{Binding CapabilityCacheNote}" Foreground="{StaticResource Accent}" Margin="0,10,0,0"/><TextBlock Text="硬件、显卡驱动、系统或 FFmpeg 变化时重新检测；也可使用上方按钮强制重检。" Foreground="{StaticResource Muted}" Margin="0,7,0,0"/><TextBlock Text="{Binding CapabilityText}" FontFamily="Consolas, Microsoft YaHei UI" Margin="0,16,0,0" TextWrapping="Wrap"/></StackPanel></Border>
        <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="任务与本地数据" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="预设、历史和探测/硬件缓存保存在 %LOCALAPPDATA%\VideoArchive。扫描最多并行探测4个文件，修改参数复用缓存；默认并行编码一个任务。取消或关闭不会删除已验证成品。" Foreground="{StaticResource Muted}" Margin="0,12,0,0"/><TextBlock Text="压缩时只保留时间码 tmcd，移除其他特殊数据轨；时间码无法可靠保留时在扫描后逐个/批量选择。10-bit 4:2:2及以上YUV转换为10-bit 4:2:0 HEVC Main10。音轨、字幕和章节保留；动态HDR与未验证容器仍原样备份。" Foreground="{StaticResource Muted}" Margin="0,12,0,0"/></StackPanel></Border>
      </StackPanel></ScrollViewer>
      <Border Grid.Row="2" Background="#E4EEF1" CornerRadius="9" Padding="13,10" Margin="0,12,0,0"><DockPanel><ProgressBar Width="65" Height="4" IsIndeterminate="True" DockPanel.Dock="Right" Visibility="{Binding Busy, Converter={StaticResource BoolVisibility}}" Margin="10,0,0,0"/><TextBlock Text="{Binding Status}" FontSize="12" Foreground="#375A6C" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/></DockPanel></Border>
    </Grid>
    <Border Grid.Column="1" Background="#FFFFFF" Width="365" HorizontalAlignment="Right" BorderBrush="#CBD8EC" BorderThickness="1,0,0,0" Padding="22" Visibility="{Binding Advanced, Converter={StaticResource BoolVisibility}}">
      <DockPanel><DockPanel DockPanel.Dock="Top" Margin="0,0,0,18"><Button Content="关闭" Command="{Binding AdvancedCommand}" DockPanel.Dock="Right"/><TextBlock Text="详细参数" FontSize="20" FontWeight="SemiBold"/></DockPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel IsEnabled="{Binding Idle}" Margin="0,0,8,0">
          <TextBlock Text="位深 / 像素格式" Style="{StaticResource Label}"/><ComboBox ItemsSource="{Binding DepthOptions}" SelectedItem="{Binding Settings.Depth}"/>
          <TextBlock Text="Profile（按每个文件自动适配）" Style="{StaticResource Label}" Margin="0,16,0,7"/><ComboBox ItemsSource="{Binding ProfileOptions}" SelectedItem="{Binding Settings.Profile}"/><TextBlock Text="HEVC：Main / Main10；H.264：High / High10；AV1：Main。扫描表中显示实际选择。" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"/>
          <TextBlock Text="编码器 Preset" Style="{StaticResource Label}" Margin="0,16,0,7"/><ComboBox ItemsSource="{Binding EncoderPresets}" SelectedItem="{Binding Settings.EncoderPreset}"/>
          <TextBlock Text="恒定质量值 / CRF、CQ" Style="{StaticResource Label}" Margin="0,16,0,7"/><TextBox Text="{Binding Settings.Cq, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="数值越低，画质通常越高；不同编码器不可直接比较。" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,6,0,0"/>
          <TextBlock Text="VBR 峰值 / 平均目标倍数" Style="{StaticResource Label}" Margin="0,16,0,7"/><TextBox Text="{Binding Settings.MaxMultiplier, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding PeakLimitSupported}"/>
          <TextBlock Text="码率触发容差 / %" Style="{StaticResource Label}" Margin="0,16,0,7"/><TextBox Text="{Binding Settings.Tolerance, UpdateSourceTrigger=PropertyChanged}"/>
          <TextBlock Text="最低预计压缩收益 / %" Style="{StaticResource Label}" Margin="0,16,0,7"/><TextBox Text="{Binding Settings.MinSavings, UpdateSourceTrigger=PropertyChanged}"/>
          <TextBlock Text="AAC 音频码率 / kbps" Style="{StaticResource Label}" Margin="0,16,0,7"/><TextBox Text="{Binding Settings.AudioKbps, UpdateSourceTrigger=PropertyChanged}"/>
          <TextBlock Text="并行任务数 / 1–8" Style="{StaticResource Label}" Margin="0,16,0,7"/><TextBox Text="{Binding Settings.Parallel, UpdateSourceTrigger=PropertyChanged}"/>
          <TextBlock Text="遇到已存在文件" Style="{StaticResource Label}" Margin="0,16,0,7"/><ComboBox ItemsSource="{Binding CollisionOptions}" SelectedItem="{Binding Settings.Collision}"/>
          <CheckBox Content="NVIDIA 空间 AQ" IsChecked="{Binding Settings.Aq}" Margin="0,18,0,6"/><CheckBox Content="NVIDIA Look-ahead" IsChecked="{Binding Settings.LookAhead}"/>
          <TextBlock Text="Level、GOP、B帧由编码器自动决定。保留色彩信息、音轨、字幕、元数据及文件时间；不可靠时原样备份。" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,15,0,10"/>
        </StackPanel></ScrollViewer>
      </DockPanel>
    </Border>
    </Grid>
  </Grid>
</Window>
