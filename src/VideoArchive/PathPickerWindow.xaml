<Window x:Class="VideoArchive.PathPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="970" Height="695" MinWidth="710" MinHeight="455"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock x:Name="Heading" FontSize="23" FontWeight="Bold" Margin="0,0,0,10"/>
            <Border x:Name="SourceDropZone" AllowDrop="True" Visibility="Collapsed"
                    CornerRadius="9" BorderThickness="1" BorderBrush="#BBD5EF" Background="#EDF5FD"
                    Margin="0,0,0,12" Padding="14,12"
                    PreviewDragEnter="SourceDragOver" PreviewDragOver="SourceDragOver"
                    PreviewDragLeave="SourceDragLeave" PreviewDrop="SourceDrop">
                <DockPanel>
                    <Path Style="{StaticResource Icon}" Data="{StaticResource FolderIcon}" Margin="0,0,12,0"/>
                    <TextBlock x:Name="SourceDropHint" FontWeight="SemiBold" Foreground="{StaticResource Accent}"
                               Text="从资源管理器拖入一个文件夹，松开后开始扫描"/>
                </DockPanel>
            </Border>
            <DockPanel Margin="0,0,0,10">
                <Button x:Name="Back" Click="BackClick" Content="返回" IsEnabled="False"/>
                <Button x:Name="Up" Click="UpClick" Content="上一级" IsEnabled="False"/>
                <Button Click="DrivesClick" Content="此电脑"/>
                <Button Click="RefreshClick" Content="刷新" DockPanel.Dock="Right" Margin="8,0,0,0"/>
                <Button Click="AddressClick" Content="前往" DockPanel.Dock="Right" Margin="8,0,0,0"/>
                <TextBox x:Name="Address" AutomationProperties.Name="文件夹地址" PreviewKeyDown="AddressKeyDown"/>
            </DockPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <Button Tag="DesktopDirectory" Content="桌面" Click="PlaceClick" Padding="12,6"/>
                <Button Tag="MyDocuments" Content="文档" Click="PlaceClick" Padding="12,6"/>
                <Button Tag="MyPictures" Content="图片" Click="PlaceClick" Padding="12,6"/>
                <Button Tag="MyVideos" Content="视频" Click="PlaceClick" Padding="12,6"/>
                <TextBlock x:Name="ContentsHint" Foreground="{StaticResource Muted}" Margin="8,0,0,0"/>
            </StackPanel>
        </StackPanel>
        <Border Grid.Row="1" x:Name="BrowserFrame" BorderBrush="#D4E1E8" BorderThickness="1" Background="White"/>
        <StackPanel Grid.Row="2" Margin="0,10,0,0">
            <TextBlock x:Name="Feedback" Foreground="{StaticResource Muted}" MinHeight="22" Margin="0,0,0,8"/>
            <DockPanel x:Name="NewFolderRow" Visibility="Collapsed" Margin="0,0,0,8">
                <TextBlock Text="新文件夹名称" Margin="0,0,10,0"/>
                <Button DockPanel.Dock="Right" Content="取消" Click="CancelNewFolder" Margin="8,0,0,0"/>
                <Button DockPanel.Dock="Right" Content="创建" Click="CreateFolder" Margin="8,0,0,0"/>
                <TextBox x:Name="NewFolderName" PreviewKeyDown="NewFolderKeyDown" AutomationProperties.Name="新文件夹名称"/>
            </DockPanel>
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="NewFolder" Content="新建文件夹" Click="NewFolderClick" Visibility="Collapsed"/>
                    <Button Content="取消" IsCancel="True"/>
                    <Button x:Name="Confirm" IsEnabled="False" IsDefault="True" Style="{StaticResource Primary}" Click="ConfirmClick" Margin="0"/>
                </StackPanel>
                <DockPanel x:Name="SaveNameRow" Visibility="Collapsed" Margin="0,0,12,0">
                    <TextBlock Text="文件名" Margin="0,0,10,0"/>
                    <TextBox x:Name="SaveName" AutomationProperties.Name="报告文件名" TextChanged="SaveNameChanged"/>
                </DockPanel>
            </DockPanel>
        </StackPanel>
    </Grid>
</Window>
